{
  "name": "musigeiros",
  "version": "2.0.0",
  "main": "index.js",
  "author": "borrageiros",
  "license": "MIT",
  "scripts": {
    "installation": "yarn install && cd client && yarn install && yarn build",
    "prestart": "test -d interface || yarn build:client",
    "start": "node src/index.js",
    "build:client": "cd client && yarn build",
    "dev": "concurrently \"yarn dev:server\" \"yarn dev:client\"",
    "dev:client": "cd client && yarn dev",
    "dev:server": "nodemon",
    "update-dependencies": "ncu -u --filter '@discord-player/extractor,discord-player-youtubei,discord-player,discord.js,@discordjs/opus,@discordjs/voice,ytdl-core,@ffmpeg-installer/ffmpeg,opusscript'"
  },
  "dependencies": {
    "@discord-player/extractor": "^7.1.0",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.18.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "body-parser": "^1.20.3",
    "concurrently": "^9.0.1",
    "cors": "^2.8.5",
    "discord-player": "^7.1.0",
    "discord-player-youtubei": "^1.5.0",
    "discord.js": "^14.21.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mediaplex": "^0.0.9",
    "npm-check-updates": "^17.1.4",
    "opusscript": "^0.1.1",
    "socket.io": "^4.8.0",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
